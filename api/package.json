{
  "name": "api",
  "version": "0.2",
  "description": "",
  "author": "Clemson",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand",
    "build": "nest build && npm run copy:assets",
    "copy:assets": "copyfiles -u 1 src/assets/images/**/* dist/src",
    "dev": "nest start --watch",
    "prod": "node dist/src/main",
    "schema:sync": "npx typeorm-ts-node-commonjs schema:sync -d ./src/database/data-source.ts",
    "typeorm:cache": "npx typeorm-ts-node-commonjs cache:clear -d ./src/database/data-source.ts",
    "schema:drop": "npx typeorm-ts-node-commonjs schema:drop -d ./src/database/data-source.ts",
    "migration:create": "typeorm migration:create ./src/migrations/schema-update",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate ./src/migrations/schema-update -d ./src/database/data-source.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d ./src/database/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d  ./src/database/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d ./src/database/data-source.ts",
    "migration:run:js": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/src/database/data-source.js",
    "schema:drop:js": "node ./node_modules/typeorm/cli.js schema:drop -d ./dist/src/database/data-source.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.18.2",
    "@faker-js/faker": "^9.8.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/elasticsearch": "^11.1.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.2",
    "@nestjs/platform-express": "^10.4.16",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "amqplib": "^0.10.8",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.4.0",
    "cache-manager-redis-store": "^2.0.0",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "elasticsearch": "^16.7.3",
    "express-session": "^1.18.1",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cache-manager": "^4.0.6",
    "@types/cache-manager-redis-store": "^2.0.4",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^shared/(.*)$": "<rootDir>/../shared/$1"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/modules/v0.2/therapy/",
      "/src/modules/v0.2/evaluation/",
      "/src/modules/v0.2/guard/",
      "/src/database/",
      "/src/app.module.ts",
      "/src/main.ts",
      "/src/migrations",
      "/src/modules/register.module.ts",
      "/src/modules/v0.2/app.module.ts",
      "/src/modules/v0.2/ai/ai.module.ts",
      "/src/modules/v0.2/user/user.module.ts",
      "/src/modules/v0.2/user/user.service.ts",
      "/src/modules/v0.2/utils/"
    ]
  }
}
