# ----------------------------------------
# Compiled output and dependencies
# These are directories and files created during build processes and package installations.
# ----------------------------------------
/dist
/node_modules
/build

# --------------------------------------
# Logs and Debug Files
# Ignore all log files generated by npm, yarn, and pnpm, along with other debug logs.
# --------------------------------------
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# -----------------------------
# OS-specific files
# These files are automatically generated by macOS and should be ignored.
# -----------------------------
.DS_Store

# -----------------------------
# Test-related files
# Ignore coverage and NYC output files generated during testing.
# -----------------------------
/coverage
/.nyc_output

# ---------------------------------
# IDEs and Editor Configurations
# Ignore editor-specific project settings and configuration files.
# ---------------------------------
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ---------------------------------------
# Visual Studio Code Settings and Workspace
# Ignore all VSCode-related files except for the essential configuration files.
# ---------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------
# Environment Variables Files
# Ignore local environment variable files, including for development, test, and production.
# ---------------------------------------
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# -------------------------
# Temporary Files and Directories
# Ignore temp and temporary files created during processes.
# -------------------------
.temp
.tmp

# ------------------------
# Runtime Data and Process Files
# Ignore files related to running processes and data.
# ------------------------
pids
*.pid
*.seed
*.pid.lock

# -----------------------------------
# Node.js Diagnostic Reports
# Ignore diagnostic report files generated by Node.js runtime errors.
# -----------------------------------
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
